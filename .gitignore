# Abhängigkeiten
node_modules/

# Build-Ausgaben
dist/
dist-portable/
dev-dist/
.vite/
# Zwischenstände der Wörterbuch-Pipeline: Die 27-MB-Extraktion ist ein
# Arbeitsergebnis, kein Quellcode. Ausgeliefert wird nur der fertige
# Laufzeitdatensatz unter src/dictionary/data/.
build/

# Playwright-Artefakte
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Testabdeckung
coverage/
.nyc_output/

# Arbeitsstand der Supabase-CLI
# `supabase link` legt hier die Projektkennung und einen Zwischenstand ab.
# Beides gehoert zu *einer* Arbeitsumgebung, nicht zum Projekt: Wer gegen ein
# anderes Projekt verknuepft, bekaeme sonst bei jedem `git status` eine
# Aenderung angezeigt, die keine ist.
supabase/.temp/

# Logs und lokale Umgebung
*.log
npm-debug.log*
.env
.env.*.local
*.local

# Betriebssystem
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
