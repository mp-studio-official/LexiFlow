{
  "name": "lexiflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LexiFlow – lokale, datensparsame Vokabeltrainer-PWA (Englisch/Deutsch, Gymnasium NRW)",
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.portal.config.ts",
    "build:portable": "node scripts/build-portable.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run scripts/db",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:portable": "playwright test --config playwright.portable.config.ts",
    "e2e:portal": "playwright test --config playwright.portal.config.ts",
    "e2e:breiten": "playwright test --config playwright.breiten.config.ts",
    "e2e:breiten:portal": "playwright test --config playwright.portal-breiten.config.ts",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "stilumfang": "node scripts/stilumfang.mjs",
    "zeichen": "node scripts/zeichen-unterscheidbar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.12",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
