# LexiFlow – die beiden Werte, die das Portal braucht.
#
# Beide dürfen öffentlich sein: Sie stehen im ausgelieferten Bündel und lassen
# sich aus jedem Browser auslesen. Die Sicherheit liegt vollständig in den
# Zugriffsregeln der Datenbank (supabase/migrations/…_zugriffsregeln.sql).
#
# Was hier NICHT hineingehört: der Secret Key und die Service Role. Die gibt es
# ausschließlich in den Function Secrets von Supabase. Eine Variable mit dem
# Präfix VITE_ landet im Bündel – ein Geheimnis darunter wäre keines mehr.
#
# Diese Datei ist die Vorlage. Die echte heißt `.env` und ist von Git
# ausgeschlossen.

VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Nur für Entwicklung und Ende-zu-Ende-Prüfungen: Statt der Cloud läuft die
# kontrollierte Fälschung aus src/application/fakeCloudRepositories.ts – mit
# erfundenen Konten, ohne dass eine Anfrage das Gerät verlässt. Eine so
# gebaute Auslieferung trägt auf jeder Seite ein Band, das sagt, was sie ist.
# VITE_LEXIFLOW_FAKE_CLOUD=1
